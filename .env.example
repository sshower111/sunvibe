# Copy to .env.local for local development. Production values live in Vercel → Settings → Environment Variables.
# Never commit real values.

# Admin
ADMIN_PASSWORD=
# Optional extra key material for admin session cookies
ADMIN_SESSION_SECRET=
# Required. The only key used to encrypt customer details at rest (pre-orders, cake inquiries and their notes and
# photos, cake orders). 32+ random characters, e.g. `openssl rand -base64 32`. Never change it once set: saved data
# would become unreadable. Independent of ADMIN_PASSWORD, so the password can change freely. Records saved before
# 2026-10-29 may use the old ADMIN_PASSWORD-derived key; they still read, and admin → Settings → "Re-encrypt old
# records" moves them to this key.
CAMPAIGN_STORAGE_SECRET=

# Supabase (database and photo storage)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=bakery-images
# Lets the iPhone Shortcut add gallery photos without signing in (32+ random characters). See docs/GALLERY-UPLOADS.md
GALLERY_SHARE_KEY=
# Optional CA certificate for verified TLS to the database (\n-escaped PEM)
SUPABASE_DB_CA=

# Email (Resend)
# Must belong to the Resend account where sunvillebakerylv.com is verified (emails are sent from orders@sunvillebakerylv.com)
RESEND_API_KEY=
# Inbox for contact, cake inquiry and pre-order emails (defaults to the bakery email in lib/site-info.ts)
NOTIFICATION_EMAIL=
# Optional email-to-SMS address for new pre-order alerts
SMS_GATEWAY_EMAIL=

# Square online cake orders (/order-cake). See docs/CAKE-ORDERS.md. Leave empty to keep the page in "coming soon"
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook for payment.updated: the exact URL registered in Square and its signature key
SQUARE_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Cloudflare Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the CAPTCHA token must come from
TURNSTILE_ALLOWED_HOSTNAMES=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to turn Google Analytics off
NEXT_PUBLIC_GA_ID=

# Set to true to show the maintenance page on all public pages (admin stays available)
MAINTENANCE_MODE=false
